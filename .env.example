# 이 파일을 복사해 .env 로 저장하고 값을 자기 것으로 바꾼다.
# 파일 이름은 정확히 .env 여야 한다 (.env.txt 가 되면 .gitignore 가 걸러 내지 못함).
# 배포한 앱에서는 같은 이름을 Streamlit Secrets 에 넣는다.

OPENROUTER_API_KEY="sk-or-v1-자기 키"
DATABASE_URL="Supabase 에서 복사한 DB 주소"
ADMIN_PASSWORD="정한 관리자 비밀번호"

